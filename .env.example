# ── Zernio API (legacy single-tenant — kept for dev CLI scripts) ──
# Get from zernio.com/dashboard/api-keys
ZERNIO_API_KEY=sk_...

# Run `npm run list` to find these values
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=

# ── Dashboard display ────────────────────────────────────────
# Your Instagram handle (shown in sidebar + status bar)
NEXT_PUBLIC_IG_USERNAME=@yourhandle

# ── One-off automation script (optional) ────────────────────
INSTAGRAM_POST_ID=
AUTOMATION_NAME=Reel DM Test
KEYWORDS=
DM_MESSAGE=Hey! Thanks for commenting — here's what you asked for 👇
COMMENT_REPLY=

# ── Multi-tenant rebuild (Phase 1+) ─────────────────────────
# Supabase: create a project at supabase.com, then:
#   Settings → Database → Connection string → URI (DIRECT, not pooler — Railway is long-running)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Settings → API → Project URL + anon key + service_role key
# Browser-readable (prefix required by @supabase/ssr client):
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only:
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SENSITIVE

# Generate with: openssl rand -hex 32
# Used by lib/crypto.ts to encrypt user-supplied Zernio/Brevo keys before storing in Postgres
ENCRYPTION_KEY=

# ── Poller (Phase 5) ────────────────────────────────────────
# Random secret; Railway cron sends this in `x-poller-secret` header
POLLER_SECRET=
